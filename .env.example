# IAM Sentinel — deployment config. Copy to `.env` (never commit it).

# ============================================================================
# AUTH — API keys with RBAC roles.  Format: "label:role:secret"
# roles: viewer < analyst < admin.  (legacy "label:secret" defaults to analyst)
# Generate secrets: openssl rand -hex 24
# ============================================================================
AUTH_ENABLED=true
IAM_SENTINEL_API_KEYS=analyst:analyst:CHANGE_ME_32+_char_secret,ci:analyst:CHANGE_ME_too,ciso:admin:CHANGE_ME_admin

# ============================================================================
# SSO — OIDC bearer JWT (optional). Front with your IdP or gateway.
# HS256 uses a shared secret; RS256 verifies against a PEM public key.
# ============================================================================
SSO_ENABLED=false
JWT_ALG=HS256
# JWT_SECRET=shared-secret-from-your-idp-or-gateway
# JWT_PUBLIC_KEY_FILE=/run/secrets/idp_public.pem     # for RS256
JWT_ISSUER=https://your-idp.example.com
# JWT_AUDIENCE=iam-sentinel
JWT_ACTOR_CLAIM=sub
JWT_ROLE_CLAIM=groups
# Map IdP groups -> RBAC roles:
JWT_ROLE_MAP=cloudsec-admins:admin,cloudsec-analysts:analyst,cloudsec-viewers:viewer

# ============================================================================
# LICENSING — offline Ed25519-signed license (issued by the vendor).
# The vendor generates your key with vendor_license_generator.py and sends you the
# LICENSE_KEY string. Paste it below. The product verifies it against the bundled
# vendor_public.pem — no internet needed. No key = free Community tier (1 seat, 100 scans/mo).
# ============================================================================
# LICENSE_KEY=<paste the LICENSE_KEY string your vendor sent you>

# ============================================================================
# TLS — built-in HTTPS (optional; else terminate at a reverse proxy).
# Generate a pilot cert: python gen_self_signed_cert.py --host iam-sentinel.internal
# ============================================================================
# TLS_CERT_FILE=/app/certs/server.crt
# TLS_KEY_FILE=/app/certs/server.key

# ============================================================================
# Remediation narrative (optional). Deterministic findings need no model.
# ============================================================================
LLM_NARRATIVE_ENABLED=true
OLLAMA_BASE_URL=http://cyber-brain:11434
DEFAULT_OLLAMA_MODEL=qwen2.5-coder:7b
LLM_TIMEOUT_SECONDS=300

# ============================================================================
DATA_DIR=/app/data
CORS_ALLOW_ORIGINS=
OFFLINE_MODE=true
LOG_LEVEL=INFO
